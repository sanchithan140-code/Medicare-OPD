APP_NAME="MEDICARE OPD"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/medicare
APP_TIMEZONE=Asia/Colombo

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medicare_opd
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# SMTP email (add your sender email and an app password)
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_sender_email@gmail.com
MAIL_PASSWORD=your_email_app_password
MAIL_FROM_ADDRESS=your_sender_email@gmail.com
MAIL_FROM_NAME="MEDICARE OPD - Mediland Hospital"
MAIL_EHLO_DOMAIN=localhost

# Use "log" during setup when SMTP is not ready:
# MAIL_MAILER=log

# AI provider order: Gemini first, Claude only as fallback
AI_PRIMARY=gemini
AI_FALLBACK=claude
AI_LOCAL_FALLBACK=true

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT=35

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514
ANTHROPIC_TIMEOUT=35

APPOINTMENT_REMINDER_HOURS=24,4
LAB_RESULT_MAX_MB=8
